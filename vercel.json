{
  "version": 2,
  "builds": [
    {
      "src": "backend/bookmyshow_backend/wsgi.py",
      "use": "@vercel/python"
    },
    {
      "src": "build.sh",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/frontend/dist/assets/$1"
    },
    {
      "src": "/(.*)",
      "dest": "backend/bookmyshow_backend/wsgi.py"
    }
  ]
}
